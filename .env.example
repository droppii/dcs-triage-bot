# Copy to .env (git-ignored). Never commit real values.

# Staging Postgres (service creds, via your staging tunnel). Either set the four DB_* keys...
# DB_HOST=127.0.0.1
# DB_PORT=15431
# DB_USER=
# DB_PASSWORD=
# ...or point to an existing env file that already has them (only DB_* lines are read):
# DCS_STG_DB_ENV_FILE=~/Documents/02_Playwright/automation-test/automation-test/.env

# Optional: model override (default in config.json)
# DCS_MODEL=sonnet

# Only for tools/stg_case.py (creating staging test data with a QA test account)
# STG_TEST_USER=nhudoan01
# STG_TEST_PASSWORD=
